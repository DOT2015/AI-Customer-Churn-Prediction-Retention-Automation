    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n    const customer = item.json;\n\n    // Convert values to numbers\n    const loginCount = Number(customer.login_count || 0);\n    const transactionCount = Number(customer.transaction_count || 0);\n    const totalSpend = Number(customer.total_spend || 0);\n    const avgTransaction = Number(customer.average_transaction || 0);\n    const ticketCount = Number(customer.ticket_count || 0);\n    const openTickets = Number(customer.open_tickets || 0);\n    const negativeTickets = Number(customer.negative_tickets || 0);\n    const totalUsage = Number(customer.total_usage || 0);\n    const featuresUsed = Number(customer.features_used || 0);\n    const monthlyRevenue = Number(customer.monthly_revenue || 0);\n\n    // Days since last login\n    const lastLogin = new Date(customer.last_login);\n    const today = new Date();\n\n    const daysSinceLastLogin =\n        Math.floor((today - lastLogin) / (1000 * 60 * 60 * 24));\n\n    //--------------------------------------------------\n    // Customer Health Metrics\n    //--------------------------------------------------\n\n    let engagementScore = 100;\n\n    engagementScore -= Math.min(daysSinceLastLogin * 2, 30);\n    engagementScore -= Math.max(0, 10 - loginCount);\n    engagementScore -= negativeTickets * 10;\n    engagementScore -= openTickets * 5;\n\n    engagementScore = Math.max(0, Math.min(100, engagementScore));\n\n    //--------------------------------------------------\n    // Churn Indicators\n    //--------------------------------------------------\n\n    const indicators = [];\n\n    if (daysSinceLastLogin > 14)\n        indicators.push(\"Inactive for over 14 days\");\n\n    if (loginCount < 5)\n        indicators.push(\"Low login frequency\");\n\n    if (totalSpend < 100)\n        indicators.push(\"Low customer spending\");\n\n    if (ticketCount >= 3)\n        indicators.push(\"Frequent support requests\");\n\n    if (negativeTickets > 0)\n        indicators.push(\"Negative support experience\");\n\n    if (totalUsage < 50)\n        indicators.push(\"Low product usage\");\n\n    if (monthlyRevenue < 100)\n        indicators.push(\"Low monthly revenue\");\n\n    //--------------------------------------------------\n    // Risk Score\n    //--------------------------------------------------\n\n    let riskScore = 0;\n\n    riskScore += Math.min(daysSinceLastLogin * 2, 30);\n\n    if (loginCount < 5)\n        riskScore += 15;\n\n    if (ticketCount >= 3)\n        riskScore += 10;\n\n    riskScore += negativeTickets * 10;\n\n    if (totalUsage < 50)\n        riskScore += 15;\n\n    if (totalSpend < 100)\n        riskScore += 10;\n\n    riskScore = Math.min(riskScore, 100);\n\n    //--------------------------------------------------\n    // Risk Level\n    //--------------------------------------------------\n\n    let riskLevel = \"LOW\";\n\n    if (riskScore >= 70)\n        riskLevel = \"HIGH\";\n    else if (riskScore >= 40)\n        riskLevel = \"MEDIUM\";\n\n    //--------------------------------------------------\n    // Add Engineered Features\n    //--------------------------------------------------\n\n    customer.days_since_last_login = daysSinceLastLogin;\n\n    customer.engagement_score = engagementScore;\n\n    customer.risk_score = riskScore;\n\n    customer.risk_level = riskLevel;\n\n    customer.churn_indicators = indicators;\n\n    customer.customer_health =\n        engagementScore >= 80\n            ? \"Excellent\"\n            : engagementScore >= 60\n            ? \"Good\"\n            : engagementScore >= 40\n            ? \"Fair\"\n            : \"Poor\";\n\n    return {\n        json: customer\n    };\n\n});"
      },
